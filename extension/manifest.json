{
  "manifest_version": 3,
  "name": "JobPilot AI : Autonomous Career Agent Companion",
  "version": "1.1.0",
  "description": "Connects your live Chromium browser (Chrome, Brave, Edge) directly to JobPilot AI desktop workstation for autonomous tab control, 1-click auto-apply and ledger sync.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "tabGroups"
  ],
  "host_permissions": [
    "http://127.0.0.1:5056/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobPilot AI Companion",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "bridge-token.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}